[Unit]
Description=Shokuno Kagakuka - One Day Experience Site
Documentation=file://__SITE_DIR__/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__SITE_DIR__
ExecStart=/usr/bin/python3 __SITE_DIR__/server.py --port __PORT__ --quiet
Restart=always
RestartSec=3
# 80番などの特権ポートを一般ユーザーで使えるようにする
AmbientCapabilities=CAP_NET_BIND_SERVICE
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
